# Copy to /etc/labnest/app.env and edit there; never commit the real file.
# The origin is intentionally blank: proxy mode refuses to start until configured.
NODE_ENV=production
LAB_HOST=127.0.0.1
LAB_PORT=4173
LAB_TRANSPORT_MODE=proxy
LAB_TRUSTED_PROXIES=127.0.0.1
LAB_CANONICAL_URL=
# Example after replacing with your real HTTPS domain: https://lab.example.org
LAB_PUBLIC_URL=
LAB_DB_PATH=/srv/labnest/data/lab.sqlite
LAB_PUBLIC_HOME=0
LAB_PREVIEW=0
LAB_CALENDAR_SYNC=1

# HTTPS terminates at the local reverse proxy. Do not set application TLS paths here.
# SMTP is optional; configure it in the administrator's mail settings after deployment.
LAB_SMTP_HOST=
LAB_SMTP_PORT=465
LAB_SMTP_USER=
LAB_SMTP_PASSWORD=
LAB_SMTP_FROM=
