# 复制为 .env 后填写；.env 仅保存在本机，不要上传或粘贴到聊天中。
# 默认只供本机开发，不能用于校园网或公网登录。
LAB_HOST=127.0.0.1
LAB_PORT=4173
LAB_TRANSPORT_MODE=development

# HTTPS 模式：将上面的模式改为 tls，并同时配置证书和私钥。
# 证书须包含实际访问的主机名或 IP；私钥只允许运行账号读取。
LAB_TLS_CERT_FILE=
LAB_TLS_KEY_FILE=
# 实际 HTTPS 根地址，例如 https://localhost:4173；不要填写页面路径。
LAB_CANONICAL_URL=
# 可选的旧 HTTP 端口，仅跳转 GET/HEAD；登录等 POST 请求会被拒绝。
LAB_HTTP_REDIRECT_PORT=

# 同机 HTTPS 反向代理模式改为 proxy，后端仍须监听回环地址。
# 同时填写实际 LAB_CANONICAL_URL，并仅列出代理连接后端时使用的 IP。
# 不接受任意来源的转发头；详见 deploy/linux/README.md。
LAB_TRUSTED_PROXIES=

# 邮件内重置链接的网站根地址，只填写协议、主机及可选端口。
# 本机 HTTP 开发可用 http://127.0.0.1:4173；HTTPS 运行时须使用 HTTPS 地址。
# 此项与管理员已保存的邮件网站地址均应与当前 HTTPS 入口一致。
LAB_PUBLIC_URL=

# 发件邮箱服务商提供的 SMTP 服务器。
LAB_SMTP_HOST=
# 465 使用直接 TLS；587 强制升级为 STARTTLS。
LAB_SMTP_PORT=465
# SMTP 登录账号，以及邮箱服务商提供的 SMTP 授权码或专用密码。
LAB_SMTP_USER=
LAB_SMTP_PASSWORD=
# 只填写单个邮箱地址。留空时使用上面的 SMTP 登录账号。
LAB_SMTP_FROM=
